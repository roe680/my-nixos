# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{
  config,
  lib,
  pkgs,
  modulesPath,
  username,
  ...
}:

{
  boot.supportedFilesystems = [ "ntfs" ];
  imports = [
    (modulesPath + "/hardware/cpu/intel-npu.nix")
    (modulesPath + "/installer/scan/not-detected.nix")
  ];
  services.asusd.enable = true;

  services.udev.packages = [ pkgs.probe-rs-tools ];
  services.udev.extraRules = ''
      # Arduino Mega 2560 (本物)
    SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0010", MODE="0666", GROUP="dialout", SYMLINK+="arduino_mega"

    # Arduino Mega 2560 R3
    SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0042", MODE="0666", GROUP="dialout", SYMLINK+="arduino_mega"

    # Arduino Mega 2560 (ブートローダー)
    SUBSYSTEM=="usb", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="003e", MODE="0666", GROUP="dialout"

    # CH340 チップ搭載クローン（中国製格安品）
    SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0666", GROUP="dialout", SYMLINK+="arduino_clone"

    # FTDI チップ搭載クローン
    SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6001", MODE="0666", GROUP="dialout"
    # Arduino Uno / Mega 2560 など
    SUBSYSTEMS=="usb", ATTRS{idVendor}=="2341", MODE:="0666", GROUP="plugdev"
    # 一般的なUSBシリアル変換チップ (CH340など)
    SUBSYSTEMS=="usb", ATTRS{idVendor}=="1a86", MODE:="0666", GROUP="plugdev"

    # CP210x (Silabs) USB-to-UART
    SUBSYSTEMS=="usb", ATTRS{idVendor}=="10c4", MODE:="0666", GROUP="dialout"
    # CH340 (QinHeng) USB-to-UART
    SUBSYSTEMS=="usb", ATTRS{idVendor}=="1a86", MODE:="0666", GROUP="dialout"
    # Espressif USB JTAG/Serial (ESP32-S3 など)
    SUBSYSTEMS=="usb", ATTRS{idVendor}=="303a", MODE:="0666", GROUP="dialout"
    # Arduino UNO R4 Minima (通常モード & ブートローダーモード)
    SUBSYSTEMS=="usb", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0069", MODE="0666", GROUP="dialout"
    SUBSYSTEMS=="usb", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0369", MODE="0666", GROUP="dialout"

    # Arduino UNO R4 WiFi (通常モード & ブートローダーモード)
    SUBSYSTEMS=="usb", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="006a", MODE="0666", GROUP="dialout"
    SUBSYSTEMS=="usb", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="036a", MODE="0666", GROUP="dialout"
  '';

  # 2. あなたのユーザーアカウントを 'dialout' グループに追加
  users.users.${username} = {
    # YOUR_USERNAME は自身のユーザー名に書き換えてください
    extraGroups = [
      "shared"
      "wheel"
      "dialout"
    ];
  };
  environment.systemPackages = with pkgs; [
    asusctl
  ];
  boot.extraModprobeConfig = "options usbhid mousepoll=1 kbpoll=1";

  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "thunderbolt"
    "usbhid"
    "usb_storage"
    "sd_mod"
  ];
  boot.initrd.kernelModules = [
    "nvme"
    "nct6775"
    "asus-nb-wmi"
    "asus-wmi"
  ];

  fileSystems."/mnt/windows" = {
    device = "/dev/disk/by-uuid/967E89EF7E89C907";
    fsType = "ntfs3";
    options = [
      "rw"
      "uid=1000"
      "gid=100"
      "umask=022"
      "nofail"
    ];
  };
  boot.kernelModules = [
    "kvm-intel"
    "cdc_acm"
  ];
  boot.extraModulePackages = [ ];

  fileSystems."/" = {
    device = "/dev/disk/by-uuid/6e45e161-be63-40eb-9a63-160b70a579b5";
    fsType = "btrfs";
    options = [
      "noatime"
      "compress=zstd"
      "commit=60"
      "discard=async"
      "subvol=@"
    ];
  };

  fileSystems."/home" = {
    device = "/dev/disk/by-uuid/6e45e161-be63-40eb-9a63-160b70a579b5";
    fsType = "btrfs";
    options = [ "subvol=@home" ];
  };

  fileSystems."/boot" = {
    device = "/dev/disk/by-uuid/3E0C-E77E";
    fsType = "vfat";
    options = [
      "fmask=0077"
      "dmask=0077"
    ];
  };

  swapDevices = [
    { device = "/dev/disk/by-uuid/61e0883e-03bf-4820-b6c6-8b8c27c1759f"; }
  ];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.intel.npu.enable = true;
  hardware.cpu.intel.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
  hardware.graphics = {
    enable = true;
    enable32Bit = true;
    extraPackages = with pkgs; [
      intel-media-driver
      vpl-gpu-rt
      mesa
      vulkan-loader
    ];
    extraPackages32 = with pkgs; [
      driversi686Linux.intel-media-driver
    ];
  };
}
